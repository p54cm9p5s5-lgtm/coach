# Dati personali: non entrano mai nel repository pubblico.
_privato/
*.backup.json
coach-backup-*.json
coach-dati-iniziali.json

.DS_Store

# Impostazioni locali dello strumento con cui si lavora al progetto: contengono
# permessi e percorsi di questo computer, non servono a nessun altro. Finora
# restavano fuori solo grazie a un ignore globale del Mac — un file che il
# progetto non contiene: su un altro computer sarebbero finite pubblicate al
# primo `git add -A`. `launch.json` invece resta, è già pubblico e dice solo
# come si avvia il server di prova.
.claude/*
!.claude/launch.json

# Il file sentinella del controllo: c'è solo mentre un controllo è in corso, e
# serve alla guardia in tools/non-fermarti.sh. Cancellarlo è il modo per
# fermare tutto. Non è roba da pubblicare.
.controllo-in-corso

# Il registro del controllo resta sul computer (scelta del 14/08)
VERIFICA.md
ESITO.md
PIANO.md
